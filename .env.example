# MongoDB connection (Atlas or self-hosted). Leave empty in dev to use an in-memory MongoDB.
MONGODB_URI=
# REQUIRED in production: long random string used to sign admin sessions.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Initial admin account (created automatically on first run) — change the password after first login.
ADMIN_EMAIL=admin@litconcierge.com
ADMIN_PASSWORD=LitAdmin@1989
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Outgoing email (enquiry/booking confirmations, admin alerts, newsletter push).
# Gmail: smtp.gmail.com, port 465, your address, and a Google "App password".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: From address, e.g. "Lit Concierge" <hello@yourdomain.com>
MAIL_FROM=
# Optional: overrides the alert inbox set in Admin > Site Settings
ADMIN_NOTIFY_EMAIL=
# Online deposits for AI-agent and quote-page bookings (Razorpay: cards, UPI, net banking).
# Leave empty to take payments offline; bookings still work and show your payment instructions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL https://<your-site>/api/payments/razorpay/webhook, event payment_link.paid
RAZORPAY_WEBHOOK_SECRET=
