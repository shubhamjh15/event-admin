# MongoDB connection (Atlas or self-hosted). Leave empty in dev to use an in-memory MongoDB.
MONGODB_URI=
# REQUIRED in production: long random string used to sign admin sessions.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Initial admin account (created automatically on first run) — change the password after first login.
ADMIN_EMAIL=admin@litconcierge.com
ADMIN_PASSWORD=LitAdmin@1989
NEXT_PUBLIC_SITE_URL=http://localhost:3000
