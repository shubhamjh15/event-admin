# MongoDB connection (Atlas or self-hosted). Leave empty in dev to use an in-memory MongoDB.
MONGODB_URI=
# Secret used to sign admin session tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
# Initial admin account (created automatically on first run)
ADMIN_EMAIL=admin@litconcierge.com
ADMIN_PASSWORD=LitAdmin@1989
NEXT_PUBLIC_SITE_URL=http://localhost:3000
